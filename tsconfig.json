{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "react"
    ],
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "index.server.ts",
    "index.client.tsx",
    "shared/**/*.ts",
    "server/**/*.ts",
    "client/**/*.ts*",
    "tests/**/*.ts",
    "package.json"
  ]
}
